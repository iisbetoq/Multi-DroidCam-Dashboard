[Unit]
Description=DroidCam NVR Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/iisbetoq/Multi-DroidCam-Dashboard
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
Environment=PORT=8080
Environment=HOST=0.0.0.0
Environment=DB_PATH=./data/nvr.db
StandardOutput=append:/home/iisbetoq/Multi-DroidCam-Dashboard/data/nvr.log
StandardError=append:/home/iisbetoq/Multi-DroidCam-Dashboard/data/nvr.log

[Install]
WantedBy=multi-user.target
